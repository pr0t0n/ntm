# Copy to .env and adjust. The install token is what operators paste into each
# agent during installation to enroll it with the platform.
NTM_INSTALL_TOKEN=ntm-install-demo-token
# Ranges the containerized demo agent scans. For a real deployment set the
# agent's NTM_RANGES to your private networks.
NTM_RANGES=172.28.0.0/24
NTM_SCAN_INTERVAL=10m
